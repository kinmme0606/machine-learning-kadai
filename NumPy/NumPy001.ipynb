      "source": [
        "# Step1. NumPyをインポート\n",
        "import numpy as np\n",
        "\n",
        "# Step2. AとBの行列を格納する多次元配列\n",
        "A = np.array([[1, 2], [3, 4]])\n",
        "\n",
        "B = np.array([[5, 6],[7, 8]])\n",
        "\n",
        "# Step3. 行列の積を計算\n",
        "C = np.dot(A, B)\n",
        "\n",
        "# Step4. 計算結果を表示\n",
        "print(C)\n",
        "\n",
        "# Step5. 行列の要素の最大値を求める\n",
        "max_value = np.max(C)\n",
        "print(max_value)"
      ]
    }
  ]
}